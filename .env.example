# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# On Vercel, add each of these under Project -> Settings -> Environment Variables.
# Never commit the filled-in version.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Neon: Dashboard -> your project -> Connection string -> "Pooled connection".
# Supabase: Project Settings -> Database -> Connection string -> URI (port 6543).
# Must include ?sslmode=require for both providers.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth (required) ------------------------------------------------------
# Signing key for the admin session JWT. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Changing it logs out every admin session.
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# --- Seed admin account (required for `npm run db:seed`) -------------------
# The seed script creates this admin if it does not already exist.
# It will NOT overwrite an existing account with the same email.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="change-this-immediately"
SEED_ADMIN_NAME="Your Name"

# --- Site URL (required in production) ------------------------------------
# Absolute origin, no trailing slash. Used for canonical tags, sitemap.xml,
# and Open Graph URLs. Locally you can leave the default.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email notifications (optional) ---------------------------------------
# If RESEND_API_KEY is unset, contact submissions are still saved to the
# database — only the notification email is skipped.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Must be a domain you verified in Resend. For quick tests Resend allows
# "onboarding@resend.dev" as the sender.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Where contact-form notifications are delivered.
CONTACT_TO_EMAIL="you@example.com"
